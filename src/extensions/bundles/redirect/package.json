{
	"name": "redirect",
	"description": "Please enter a description for your extension",
	"icon": "extension",
	"version": "1.0.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "endpoint",
				"name": "redirect",
				"source": "src/index.ts"
			},
			{
				"type": "module",
				"name": "dashboard-redirect",
				"source": "src/app/index.ts"
			}
		],
		"host": "^11.17.4"
	},
	"scripts": {
		"build": "directus-extension build --no-minify",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link"
	},
	"devDependencies": {
		"@directus/extensions": "^3.0.25",
		"@directus/extensions-sdk": "^17.1.4",
		"@directus/types": "^15.0.3",
		"@types/node": "^22.13.14",
		"typescript": "^5.8.3",
		"vue": "^3.5.18"
	},
	"dependencies": {
		"handlebars": "^4.7.8"
	}
}
